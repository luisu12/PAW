@model PAW.Models.DTO.InventoryDTO
@{
    ViewData["Title"] = "Delete Inventory";
}

<div class="container mt-4">
    <h2>Delete Inventory</h2>
    <p>Are you sure you want to delete this inventory record?</p>
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.InventoryID</dd>

        <dt class="col-sm-3">Unit Price</dt>
        <dd class="col-sm-9">@Model.UnitPrice</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="InventoryID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
