@model PAW.Models.DTO.PawTask2DTO
@{
    ViewData["Title"] = "Delete Task2";
}

<div class="container mt-4">
    <h2>Delete Task2</h2>
    <div class="alert alert-info" role="alert">Data coming from API, action is not possible.</div>
    <p>Are you sure you want to delete this Task2 item?</p>
    <dl class="row">
        <dt class="col-sm-3">Task2 ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
