@model PAW.Models.DTO.PawTask2DTO
@{
    ViewData["Title"] = "Edit Task2";
}

<div class="container mt-4">
    <h2>Edit Task2</h2>
    <div class="alert alert-info" role="alert">Data coming from API, action is not possible.</div>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">User ID</label>
            <input asp-for="UserId" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="form-check mb-3">
            <input asp-for="Completed" class="form-check-input" />
            <label asp-for="Completed" class="form-check-label">Completed</label>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
