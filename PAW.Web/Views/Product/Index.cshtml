@model IEnumerable<PAW.Models.DTO.ProductDTO>
@{
    ViewData["Title"] = "Product Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-end mb-3">
        <div id="exchangeRateCard" class="card border-0 shadow-sm d-none" style="max-width: 320px; width: 100%;">
            <div class="card-body py-2 px-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0">Exchange rate</h6>
                    <small id="exchangeRateUpdated" class="text-muted"></small>
                </div>
                <div id="exchangeRateStatus" class="small text-muted mb-2">Loading...</div>
                <div class="small d-flex justify-content-between">
                    <span>USD Buy</span>
                    <strong id="exchangeRateBuy">-</strong>
                </div>
                <div class="small d-flex justify-content-between">
                    <span>USD Sell</span>
                    <strong id="exchangeRateSell">-</strong>
                </div>
                <div class="small d-flex justify-content-between">
                    <span>EUR/USD</span>
                    <strong id="exchangeRateEuroUsd">-</strong>
                </div>
                <div class="small d-flex justify-content-between">
                    <span>EUR/CRC</span>
                    <strong id="exchangeRateEuroCrc">-</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Product
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Product ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var product in Model)
                            {
                                <tr>

                                    <td>
                                        @product.ProductId
                                    </td>

                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>

                                    <td>
                                        @product.Description
                                    </td>

                                    <td>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= product.Rating)
                                            {
                                                <span class="text-warning">★</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">☆</span>
                                            }
                                        }
                                    </td>

                                    <td>
                                        @product.Comments
                                    </td>

                                    <td>
                                        @product.CreatedBy
                                    </td>

                                    <td>
                                        @product.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @product.ModifiedBy
                                    </td>

                                    <td>
                                        @product.ModifiedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    No products found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

@Html.Partial("_Pager")
    </div>

</div>
