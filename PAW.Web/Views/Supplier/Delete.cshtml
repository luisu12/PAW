@model PAW.Models.DTO.SupplierDTO
@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container mt-4">
    <h2>Delete Supplier</h2>
    <p>Are you sure you want to delete this supplier?</p>
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.SupplierID</dd>

        <dt class="col-sm-3">Supplier Name</dt>
        <dd class="col-sm-9">@Model.SupplierName</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="SupplierID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
