@model PAW.Models.DTO.SupplierDTO
@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container mt-4">
    <h2>Supplier Details</h2>
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.SupplierID</dd>

        <dt class="col-sm-3">Supplier Name</dt>
        <dd class="col-sm-9">@Model.SupplierName</dd>
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.ContactTitle</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>

        <dt class="col-sm-3">Country</dt>
        <dd class="col-sm-9">@Model.Country</dd>
    </dl>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
