@model IEnumerable<PAW.Models.DTO.SupplierDTO>
@{
    ViewData["Title"] = "Supplier Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Suppliers</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Supplier
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Supplier ID</th>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Title</th>
                            <th>Phone</th>
                            <th>Country</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var supplier in Model)
                            {
                                <tr>
                                    <td>
                                        @supplier.SupplierID
                                    </td>
                                    <td>
                                        <strong>@supplier.SupplierName</strong>
                                    </td>
                                    <td>
                                        @supplier.ContactName
                                    </td>
                                    <td>
                                        @supplier.ContactTitle
                                    </td>
                                    <td>
                                        @supplier.Phone
                                    </td>
                                    <td>
                                        @supplier.Country
                                    </td>
                                    <td>
                                        @supplier.ModifiedBy
                                    </td>
                                    <td>
                                        @supplier.LastModified?.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@supplier.SupplierID" class="btn btn-sm btn-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@supplier.SupplierID" class="btn btn-sm btn-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@supplier.SupplierID" class="btn btn-sm btn-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">No suppliers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>

@Html.Partial("_Pager")
    </div>

</div>
