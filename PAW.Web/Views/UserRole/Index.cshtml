@model IEnumerable<PAW.Models.DTO.UserRoleDTO>
@{
    ViewData["Title"] = "User Role Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-end mb-3">
        <div id="exchangeRateCard" class="card border-0 shadow-sm d-none" style="max-width: 320px; width: 100%;">
            <div class="card-body py-2 px-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0">Exchange rate</h6>
                    <small id="exchangeRateUpdated" class="text-muted"></small>
                </div>
                <div id="exchangeRateStatus" class="small text-muted mb-2">Loading...</div>
                <div class="small d-flex justify-content-between">
                    <span>USD Buy</span>
                    <strong id="exchangeRateBuy">-</strong>
                </div>
                <div class="small d-flex justify-content-between">
                    <span>USD Sell</span>
                    <strong id="exchangeRateSell">-</strong>
                </div>
                <div class="small d-flex justify-content-between">
                    <span>EUR/USD</span>
                    <strong id="exchangeRateEuroUsd">-</strong>
                </div>
                <div class="small d-flex justify-content-between">
                    <span>EUR/CRC</span>
                    <strong id="exchangeRateEuroCrc">-</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User Roles</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add User Role
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Link ID</th>
                            <th>Role ID</th>
                            <th>User ID</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var userRole in Model)
                            {
                                <tr>
                                    <td>
                                        @userRole.Id
                                    </td>
                                    <td>
                                        @userRole.RoldID
                                    </td>
                                    <td>
                                        @userRole.UserID
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@userRole.Id" class="btn btn-sm btn-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@userRole.Id" class="btn btn-sm btn-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@userRole.Id" class="btn btn-sm btn-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No user roles linked found.</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </div>

@Html.Partial("_Pager")
    </div>

</div>
